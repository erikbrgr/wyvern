{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "label": "npm: compile",
      "detail": "Compile the extension TypeScript"
    },
    {
      "label": "compile Sync",
      "type": "shell",
      "command": "npm install --no-audit --no-fund && npm run compile",
      "options": {
        "cwd": "${workspaceFolder}/../vscode-sync"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "compile LSP + Sync",
      "dependsOn": ["npm: compile", "compile Sync"],
      "group": "build"
    }
  ]
}
