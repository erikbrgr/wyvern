{
  "name": "wyvern-lsp",
  "displayName": "Wyvern LSP",
  "description": "An LSP for Draconic, providing diagnostics, hover docs, and code completion for Avrae alias scripting.",
  "version": "0.1.0",
  "publisher": "erikbrgr",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#74258a",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/erikbrgr/wyvern"
  },
  "homepage": "https://github.com/erikbrgr/wyvern",
  "bugs": {
    "url": "https://github.com/erikbrgr/wyvern/issues"
  },
  "keywords": ["avrae", "draconic", "lsp", "d&d", "discord", "alias"],
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages", "Linters"],
  "activationEvents": [
    "onCommand:extension.start"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "draconic",
        "aliases": ["Draconic", "draconic"],
        "extensions": [".alias", ".snippet"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "draconic-gvar",
        "aliases": ["Draconic", "draconic"],
        "extensions": [".gvar", ".draconic"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "draconic",
        "scopeName": "source.draconic",
        "path": "./syntaxes/draconic.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.python": "python"
        }
      },
      {
        "language": "draconic-gvar",
        "scopeName": "source.draconic.gvar",
        "path": "./syntaxes/draconic-gvar.tmLanguage.json",
        "embeddedLanguages": {
          "source.python": "python"
        }
      }
    ],
    "configuration": {
      "title": "Wyvern Draconic LSP",
      "properties": {
        "wyvern.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python executable to use for the Wyvern LSP server. Leave empty to auto-detect."
        },
        "wyvern.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the wyvern module or script. Leave empty to use the installed 'wyvern-lsp' package."
        },
        "wyvern.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Enable tracing of LSP communication between VS Code and the Wyvern server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "lint": "eslint src"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  }
}
